# BFF: server-only settings. Never use NEXT_PUBLIC_ for shared secrets.
# Include /api; public catalog requests retain NEXT_PUBLIC_API_BASE_URL.
DJANGO_API_URL=http://127.0.0.1:8000/api
# Generate a long random value and configure the same value in Django.
BFF_SHARED_SECRET=
# Canonical storefront origin, without a trailing slash (required in production).
BFF_ORIGIN=http://localhost:3000
# Optional: only a client-IP header overwritten by your trusted hosting ingress.
# Vercel automatically uses x-vercel-forwarded-for. Never trust an arbitrary client header.
BFF_CLIENT_IP_HEADER=
# Comma-separated origins for uploaded media served by an S3 bucket or CDN.
# Example: MEDIA_IMAGE_ORIGINS=https://your-bucket.s3.region.amazonaws.com
MEDIA_IMAGE_ORIGINS=
